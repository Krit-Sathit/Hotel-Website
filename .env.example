# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use the Supabase anon key only when a server role key is not available.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key: add this in Vercel, never expose it in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SMTP settings shared with Flow CM. Use the same provider/account that sends
# booking notifications; SMTP_FROM is optional and defaults to SMTP_USER.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@your-domain.com
SMTP_PASS=your_smtp_password_or_app_password
SMTP_FROM=FlowStay Website <notifications@your-domain.com>
