# Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Use the Supabase anon key only when a server role key is not available.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only key: add this in Vercel, never expose it in client-side code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend is used to deliver contact-form notifications. The From address must
# use a domain verified in your Resend account.
RESEND_API_KEY=re_your_resend_api_key
CONTACT_EMAIL_FROM=FlowStay Notifications <notifications@your-domain.com>
